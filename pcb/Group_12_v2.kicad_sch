	(text_box "Bidirectional Data Bus Level Shifters (1.8V <-> 3.3V)\nDIR = Shifter_dir : H = chip drives (A->B), L = tester drives (B->A)\n/OE = Data_bus_OE_n: L = enabled, H = both ports Hi-Z\n/OE is driven by U5 channel 1 (clk's old slot). R39 1.2K on the 3.3V side sets the\npower-up default; R35 1K backs it up while U5's A-side is Hi-Z. Change DIR only while /OE is H"
		(exclude_from_sim no)
		(at 218.44 15.24 0)
		(size 186.69 144.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
